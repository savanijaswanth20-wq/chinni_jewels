rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isStaff() {
      return hasRole('STAFF');
    }

    function isAdminOrStaff() {
      return isAdmin() || isStaff();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdminOrStaff();
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if resource.data.isActive == true || isAdminOrStaff();
      allow write: if isAdminOrStaff();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if resource.data.isActive == true || isAdminOrStaff();
      allow write: if isAdminOrStaff();
    }

    // Product Images
    match /product_images/{imageId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    // Gold Rates Collection
    match /gold_rates/{rateId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    // Inventory Collection
    match /inventory/{productId} {
      allow read: if isAdminOrStaff();
      allow write: if isAdminOrStaff();
    }

    // Inventory Transactions Collection
    match /inventory_transactions/{transactionId} {
      allow read: if isAdminOrStaff();
      allow write: if isAdminOrStaff();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if (isAuthenticated() && resource.data.customerId == request.auth.uid) || isAdminOrStaff();
      allow create: if true; // Support guest checkout & customer ordering; Cloud Functions validate transaction
      allow update: if (isAuthenticated() && resource.data.customerId == request.auth.uid && request.resource.data.orderStatus == 'CANCELLED' && resource.data.orderStatus == 'PENDING') || isAdminOrStaff();
      allow delete: if isAdmin();

      match /items/{itemId} {
        allow read: if (isAuthenticated() && get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid) || isAdminOrStaff();
        allow write: if isAdminOrStaff();
      }
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read: if (isAuthenticated() && request.auth.uid == customerId) || isAdminOrStaff();
      allow write: if (isAuthenticated() && request.auth.uid == customerId) || isAdminOrStaff();
    }

    // Returns Collection
    match /returns/{returnId} {
      allow read: if (isAuthenticated() && resource.data.customerId == request.auth.uid) || isAdminOrStaff();
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdminOrStaff();
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if isAdminOrStaff();
      allow write: if isAdminOrStaff();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
