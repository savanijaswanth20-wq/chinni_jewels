# Database Configuration (SQLite by default for local development, PostgreSQL for production/Supabase)
DATABASE_URL=sqlite:///./gold_business.db

# Supabase Auth / Security
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Auth Secret (REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Credentials (set these for first-run seeding)
ADMIN_EMAIL=admin@chinnijewels.com
ADMIN_PASSWORD=

# WhatsApp Business Integration
WHATSAPP_BUSINESS_NUMBER=916304702907

# CORS & Server
CORS_ORIGINS=["*"]
ENVIRONMENT=development
PORT=8000

