rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnderMaxSize(maxMegabytes) {
      return request.resource.size < maxMegabytes * 1024 * 1024;
    }

    // Product Images
    match /products/{productId}/{imageName} {
      allow read: if true;
      allow write, delete: if isAuthenticated() && isImage() && isUnderMaxSize(10);
    }

    // Media & Branding Assets (Logos, Hero, Categories, About, Testimonials, General Media)
    match /{folder}/{imageName} {
      allow read: if true;
      allow write, delete: if isAuthenticated() && (folder in ['branding', 'hero', 'categories', 'about', 'testimonials', 'media', 'products']) && isImage() && isUnderMaxSize(10);
    }

    // User Profile Photos
    match /users/{userId}/{photoName} {
      allow read: if true;
      allow write, delete: if isOwner(userId) && isImage() && isUnderMaxSize(5);
    }

    // Documents
    match /documents/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
