# ==============================================================================
# CHINNI JEWELS — Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit your .env file to version control.
# ==============================================================================

# Server & Runtime Configuration
PORT=8000
FRONTEND_PORT=8081
ENVIRONMENT=development
SITE_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# 1. Local Docker Compose PostgreSQL (default for docker compose):
DATABASE_URL=postgresql://postgres:postgres_secure_password@db:5432/chinni_jewels
DB_HOST=db
DB_PORT=5432
DB_NAME=chinni_jewels
DB_USER=postgres
DB_PASSWORD=postgres_secure_password

# 2. Or MySQL Docker Service (if using MySQL):
# DATABASE_URL=mysql+pymysql://chinni_user:mysql_secure_password@db:3306/chinni_jewels

# 3. Or Remote Supabase PostgreSQL (replace with your credentials):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.povomkepfcyfgqxdajym.supabase.co:5432/postgres

# 4. Or Local SQLite Fallback:
# DATABASE_URL=sqlite:///./gold_business.db

# ------------------------------------------------------------------------------
# Supabase Configuration (Optional - for Cloud Storage & Auth)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SECRET_KEY=your-service-role-or-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Supabase S3 Compatible Storage
SUPABASE_S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1
SUPABASE_STORAGE_BUCKET=product-images

# ------------------------------------------------------------------------------
# Application Security & Auth
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=generate_with_python_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin User
ADMIN_EMAIL=admin@chinnijewels.com
ADMIN_PASSWORD=your_secure_admin_password

# ------------------------------------------------------------------------------
# External Integrations
# ------------------------------------------------------------------------------
WHATSAPP_BUSINESS_NUMBER=916304702907
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_ID=
